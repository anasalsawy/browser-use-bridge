[Unit]
Description=VM Shell MCP Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/browser-use-bridge
EnvironmentFile=/home/azureuser/browser-use-bridge/.env
ExecStart=/usr/bin/node /home/azureuser/browser-use-bridge/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/azureuser

[Install]
WantedBy=multi-user.target
