[Unit]
Description=Travel Sales Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/browser-use-bridge/travel-sales-agent
EnvironmentFile=-/etc/leadpilotai.env
EnvironmentFile=-/etc/leadpilotai/agent.env
EnvironmentFile=-/home/azureuser/browser-use-bridge/.env
Environment="TRAVEL_AGENT_PORT=8890"
Environment="AI_BASE_URL=https://router.huggingface.co/v1"
Environment="AI_MODEL=openai/gpt-oss-120b:groq"
Environment="AI_PROVIDER=huggingface"
ExecStart=/usr/bin/node /home/azureuser/browser-use-bridge/travel-sales-agent/server.mjs
Restart=always
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/azureuser

[Install]
WantedBy=multi-user.target
